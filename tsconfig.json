{
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "declaration": true,
    "target": "es2015",
    "lib": ["es2015", "es2017"],
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "outDir": "lib",
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/**/*.test.ts", "src/**/*.spec.ts"]
}